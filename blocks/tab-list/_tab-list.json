{
    "definitions": [
        {
            "title": "Tab Panel",
            "id": "tab-panel",
            "plugins": {
                "xwalk": {
                    "page": {
                        "resourceType": "core/franklin/components/section/v1/section",
                        "template": {
                            "name": "Tab Panel",
                            "model": "tab-panel",
                            "filter": "section",
                            "tab-label": "Tab"
                        }
                    }
                }
            }
        },
        {
            "title": "Tab List",
            "id": "tab-list",
            "plugins": {
                "xwalk": {
                    "page": {
                        "resourceType": "core/franklin/components/block/v1/block",
                        "template": {
                            "name": "Tab List",
                            "model": "tab-list"
                        }
                    }
                }
            }
        }
    ],
    "models": [
        {
            "id": "tab-panel",
            "fields": [
                {
                    "component": "reference",
                    "name": "image",
                    "label": "Image",
                    "multi": false
                },
                {
                    "component": "text",
                    "name": "imageAlt",
                    "label": "Alt Text"
                },
                {
                    "component": "richtext",
                    "name": "tab-label",
                    "label": "Label"
                },
                {
                    "component": "multiselect",
                    "name": "style",
                    "label": "Style",
                    "options": [
                        {
                            "name": "Find a PLan",
                            "value": "find-plan"
                        },
                        {
                            "name": "Header Tab",
                            "value": "header-tab"
                        },
                        {
                            "name": "Insurance Content Tab",
                            "value": "insurance-content-tab"
                        },
                        {
                            "name": "Calc Card",
                            "value": "calc-card"
                        },
                        {
                            "name": "Tab Animation",
                            "value": "tab-animation"
                        },
                        {
                            "name": "Show Bullets",
                            "value": "show-bullets"
                        },
                        {
                            "name": "List Spacing (Margin Bottom 10)",
                            "value": "list-spacing"
                        },
                        {
                            "name":"Tab Life Stage",
                            "value":"tab-life-stage"
                        }
                    ]
                },
                {
                    "component": "select",
                    "name": "pulse-path",
                    "label": "Pulse Path",
                    "description": "How the pulse line runs through this section. Presets adapt to desktop and mobile; choose Custom to enter your own points.",
                    "valueType": "string",
                    "options": [
                        {
                            "name": "None",
                            "value": "none"
                        },
                        {
                            "name": "Down the left side",
                            "value": "left"
                        },
                        {
                            "name": "Down the right side",
                            "value": "right"
                        },
                        {
                            "name": "Left side, then cross to the right",
                            "value": "left-to-right"
                        },
                        {
                            "name": "Right side, then cross to the left",
                            "value": "right-to-left"
                        },
                        {
                            "name": "Down the left side with a loop",
                            "value": "loop-left"
                        },
                        {
                            "name": "Down the right side with a loop",
                            "value": "loop-right"
                        },
                        {
                            "name": "Custom points",
                            "value": "custom"
                        }
                    ]
                },
                {
                    "component": "text",
                    "name": "animation-point",
                    "label": "Animation Point",
                    "description": "Custom points for desktop. Create them on the page preview with ?pulse-edit, then copy and paste here.",
                    "condition": {
                        "===": [
                            {
                                "var": "pulse-path"
                            },
                            "custom"
                        ]
                    }
                },
                {
                    "component": "text",
                    "name": "animation-point-mobile",
                    "label": "Animation Point mobile",
                    "description": "Custom points below 900px. Leave empty to use the desktop points. Create them with ?pulse-edit.",
                    "condition": {
                        "===": [
                            {
                                "var": "pulse-path"
                            },
                            "custom"
                        ]
                    }
                }
            ]
        },
        {
            "id": "tab-list",
            "fields": [
                {
                    "component": "boolean",
                    "name": "classes_showAll",
                    "label": "Show All?",
                    "description": "When enabled, the tab list will prepend a show all button."
                }
            ]
        }
    ],
    "filters": []
}