{
  "definitions": [
    {
      "title": "Media Center",
      "id": "media-center",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Media Center",
              "model": "media-center",
              "filter": "media-center",
              "searchPlaceholder": "Search...",
              "searchLabel": "Search the media center",
              "yearLabel": "Financial year",
              "allYearsLabel": "All years",
              "monthLabel": "Month",
              "allMonthsLabel": "All months",
              "chooseLabel": "Choose category",
              "closeLabel": "Close",
              "downloadLabel": "Download",
              "resultsLabel": "{count} results",
              "emptyMessage": "No results match your search or filters.",
              "clearLabel": "Clear filters",
              "pressPageSize": 12,
              "campaignPageSize": 9,
              "previousLabel": "Previous page",
              "nextLabel": "Next page",
              "pageLabel": "Page",
              "groupLabel": "Media type"
            }
          }
        }
      }
    },
    {
      "title": "Media Tab",
      "id": "media-center-group",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Media Tab",
              "model": "media-center-group",
              "title": "Press Releases",
              "anchor": "press-releases"
            }
          }
        }
      }
    },
    {
      "title": "Press Release",
      "id": "media-center-release",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Press Release",
              "model": "media-center-release"
            }
          }
        }
      }
    },
    {
      "title": "Campaign",
      "id": "media-center-campaign",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Campaign",
              "model": "media-center-campaign",
              "imageMimeType": "image/jpeg"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "media-center",
      "fields": [
        {
          "component": "richtext",
          "name": "text",
          "label": "Heading",
          "description": "The section heading, e.g. Our <strong>media</strong> center",
          "value": ""
        },
        {
          "component": "text",
          "name": "searchPlaceholder",
          "label": "Search placeholder",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "searchLabel",
          "label": "Search field label",
          "valueType": "string",
          "description": "Read by screen readers"
        },
        {
          "component": "text",
          "name": "yearLabel",
          "label": "Year filter label",
          "valueType": "string",
          "description": "Read by screen readers on the year filter"
        },
        {
          "component": "text",
          "name": "allYearsLabel",
          "label": "All years option",
          "valueType": "string",
          "description": "The first year option; it clears the year filter"
        },
        {
          "component": "text",
          "name": "monthLabel",
          "label": "Month filter label",
          "valueType": "string",
          "description": "Shown on the month filter when no month is picked"
        },
        {
          "component": "text",
          "name": "allMonthsLabel",
          "label": "All months option",
          "valueType": "string",
          "description": "The first month option; it clears the month filter"
        },
        {
          "component": "text",
          "name": "chooseLabel",
          "label": "Filter list heading (mobile)",
          "valueType": "string",
          "description": "Shown above the options in the full screen list on mobile"
        },
        {
          "component": "text",
          "name": "closeLabel",
          "label": "Close label",
          "valueType": "string",
          "description": "Read by screen readers on the close button of the mobile list"
        },
        {
          "component": "text",
          "name": "downloadLabel",
          "label": "Download label",
          "valueType": "string",
          "description": "Read by screen readers on press release cards"
        },
        {
          "component": "text",
          "name": "resultsLabel",
          "label": "Results count",
          "valueType": "string",
          "description": "Read by screen readers when the results change; use {count}"
        },
        {
          "component": "text",
          "name": "emptyMessage",
          "label": "No results message",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "clearLabel",
          "label": "Clear filters label",
          "valueType": "string"
        },
        {
          "component": "number",
          "name": "pressPageSize",
          "label": "Press releases per page",
          "valueType": "number"
        },
        {
          "component": "number",
          "name": "campaignPageSize",
          "label": "Campaigns per page",
          "valueType": "number"
        },
        {
          "component": "text",
          "name": "previousLabel",
          "label": "Previous page label",
          "valueType": "string",
          "description": "Read by screen readers"
        },
        {
          "component": "text",
          "name": "nextLabel",
          "label": "Next page label",
          "valueType": "string",
          "description": "Read by screen readers"
        },
        {
          "component": "text",
          "name": "pageLabel",
          "label": "Page label",
          "valueType": "string",
          "description": "Read by screen readers before each page number"
        },
        {
          "component": "text",
          "name": "groupLabel",
          "label": "Media type list label",
          "valueType": "string",
          "description": "Read by screen readers for the tabs (a dropdown on mobile)"
        }
      ]
    },
    {
      "id": "media-center-group",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Tab name",
          "valueType": "string",
          "description": "e.g. Press Releases. The items after it, up to the next tab, belong to it."
        },
        {
          "component": "text",
          "name": "anchor",
          "label": "Anchor",
          "valueType": "string",
          "description": "Optional, e.g. our-campaigns: a link to #our-campaigns opens this tab"
        }
      ]
    },
    {
      "id": "media-center-release",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "valueType": "string",
          "required": true
        },
        {
          "component": "date-time",
          "name": "date",
          "label": "Release date",
          "description": "Shown on the card and used by the year and month filters",
          "valueType": "date"
        },
        {
          "component": "aem-content",
          "name": "document",
          "label": "Document",
          "description": "The press release PDF (opens and downloads from the card)"
        }
      ]
    },
    {
      "id": "media-center-campaign",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Thumbnail",
          "multi": false,
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Thumbnail alt text",
          "valueType": "string"
        },
        {
          "component": "hidden",
          "valueType": "string",
          "name": "imageMimeType",
          "value": "image/jpeg"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "valueType": "string",
          "required": true
        },
        {
          "component": "text",
          "name": "description",
          "label": "Description",
          "valueType": "string"
        },
        {
          "component": "aem-content",
          "name": "video",
          "label": "Video",
          "description": "A DAM video, YouTube or Vimeo link; it plays in a dialog"
        },
        {
          "component": "date-time",
          "name": "date",
          "label": "Campaign date",
          "description": "Used by the year and month filters",
          "valueType": "date"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "media-center",
      "components": [
        "media-center-group",
        "media-center-release",
        "media-center-campaign"
      ]
    }
  ]
}
