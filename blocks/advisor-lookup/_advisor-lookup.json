{
  "definitions": [
    {
      "title": "Advisor Lookup",
      "id": "advisor-lookup",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Advisor Lookup",
              "model": "advisor-lookup",
              "placeholder": "eg. 98765412",
              "resultsLabel": "{count} results found : {id}"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "advisor-lookup",
      "fields": [
        {
          "component": "richtext",
          "valueType": "string",
          "name": "text",
          "label": "Heading",
          "description": "Centred section heading (bold words are shown heavier)",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "placeholder",
          "label": "Search placeholder",
          "description": "Shown in the empty search field",
          "value": "eg. 98765412"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "searchLabel",
          "label": "Search label",
          "description": "Read by screen readers",
          "value": "Life Advisor ID"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "submitLabel",
          "label": "Search button label",
          "description": "Read by screen readers",
          "value": "Search"
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "hint",
          "label": "Hint",
          "description": "Below the search field, for example Search by ID eg: 98765412 (bold text is shown darker)",
          "value": ""
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "resultsLabel",
          "label": "Results line",
          "description": "{count} is the number of results, {id} the ID searched",
          "value": "{count} results found : {id}"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "emptyMessage",
          "label": "No result message",
          "description": "{id} is the ID searched",
          "value": "No Life Advisor was found with the ID {id}. Please check the ID and try again."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "invalidMessage",
          "label": "Invalid ID message",
          "description": "",
          "value": "Please enter a valid Life Advisor ID, using numbers only."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "errorMessage",
          "label": "Error message",
          "description": "When the search does not answer",
          "value": "We could not search right now. Please try again later."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "idLabel",
          "label": "ID label",
          "description": "",
          "value": "ID"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "genderLabel",
          "label": "Gender label",
          "description": "",
          "value": "Gender"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "typeLabel",
          "label": "Type label",
          "description": "",
          "value": "Type"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "appointmentLabel",
          "label": "Date of appointment label",
          "description": "",
          "value": "Date of Appointment"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "validLabel",
          "label": "Valid till label",
          "description": "",
          "value": "Valid till"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "photoLabel",
          "label": "Photo alt text",
          "description": "{name} is the advisor name",
          "value": "Photo of {name}"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "source",
          "label": "Advisor data",
          "description": "A URL with {id} (the advisor API) or a spreadsheet JSON with the columns id, name, photo, status, gender, type, appointmentDate, validTill",
          "value": ""
        }
      ]
    }
  ],
  "filters": []
}
