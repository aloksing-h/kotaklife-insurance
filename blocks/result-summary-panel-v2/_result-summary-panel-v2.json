          "label": "Calculator type",
          "value": "term",
          "options": [
            {
              "name": "Term Insurance calculator",
              "value": "term"
            }
          ]
        },
        {
          "component": "reference",
          "name": "term-illustration",
          "label": "Term insurance illustration",
          "multi": false,
          "description": "Optional image shown beside the term insurance result.",
