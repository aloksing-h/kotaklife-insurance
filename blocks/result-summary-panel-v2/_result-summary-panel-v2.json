{
  "definitions": [
    {
      "title": "Result Summary Panel V2",
      "id": "result-summary-panel-v2",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Result Summary panel V2",
              "model": "result-summary-panel-v2"
            }
          }
        }
      }
    }
  ],
  "models": [
