{
  "definitions": [
    {
      "title": "Eligibility Tabs",
      "id": "eligibility-tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Eligibility Tabs",
              "model": "eligibility-tabs",
              "filter": "eligibility-tabs"
            }
          }
        }
      }
    },
    {
      "title": "Eligibility Tab (variations 1 and 3)",
      "id": "eligibility-tabs-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Eligibility Tab",
              "model": "eligibility-tabs-item"
            }
          }
        }
      }
    },
    {
      "title": "Eligibility Row (variation 2)",
      "id": "eligibility-tabs-row",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Eligibility Row",
              "model": "eligibility-tabs-row"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "eligibility-tabs",
      "fields": [
        {
          "component": "select",
          "name": "classes",
          "label": "Variation",
          "description": "Variation 1: collapsible card with tabbed tables (Eligibility Tab items). Variation 2: comparison table (Eligibility Row items). Variation 3: side tabs with rich content (Eligibility Tab items).",
          "valueType": "string",
          "value": "",
          "options": [
            {
              "name": "Variation 1 - Collapsible tabs",
              "value": ""
            },
            {
              "name": "Variation 2 - Comparison table",
              "value": "variation-2"
            },
            {
              "name": "Variation 3 - Side tabs with content",
              "value": "variation-3"
            }
          ]
        },
        {
          "component": "richtext",
          "name": "text",
          "label": "Heading & Subtitle",
          "description": "Heading 2 (bold the highlighted word) followed by a short subtitle. Variation 3 centres it above the tabs.",
          "value": "",
          "valueType": "string"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Illustration (variations 1 and 2)",
          "multi": false,
          "condition": {
            "!==": [
              {
                "var": "classes"
              },
              "variation-3"
            ]
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Illustration Alt",
          "description": "Leave empty when the illustration is decorative",
          "value": "",
          "condition": {
            "!==": [
              {
                "var": "classes"
              },
              "variation-3"
            ]
          }
        },
        {
          "component": "hidden",
          "name": "imageMimeType",
          "value": "image/png"
        },
        {
          "component": "boolean",
          "name": "options_expanded",
          "label": "Open by default",
          "valueType": "boolean",
          "value": false,
          "condition": {
            "!": {
              "var": "classes"
            }
          }
        },
        {
          "component": "richtext",
          "name": "options_columns",
          "label": "Comparison Columns",
          "description": "Bulleted list of the column headings, in order, e.g. Life ROP Option, Legacy ROP Option",
          "value": "",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "classes"
              },
              "variation-2"
            ]
          }
        }
      ]
    },
    {
      "id": "eligibility-tabs-item",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Tab Label",
          "value": "",
          "description": "Shown in the tab list (and the mobile dropdown)"
        },
        {
          "component": "richtext",
          "name": "content",
          "label": "Table",
          "description": "Variation 1: insert a table (repeat a value in the first column or header rows to merge cells; an empty cell merges into the one on its left). Variation 3: heading, intro paragraph and a bulleted list where each item starts with its bold title.",
          "value": "",
          "valueType": "string"
        }
      ]
    },
    {
      "id": "eligibility-tabs-row",
      "fields": [
        {
          "component": "reference",
          "valueType": "string",
          "name": "image",
          "label": "Icon",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Icon Alt",
          "description": "Leave empty when the icon is decorative",
          "value": ""
        },
        {
          "component": "hidden",
          "name": "imageMimeType",
          "value": "image/png"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Row Label",
          "description": "e.g. Minimum Age",
          "value": ""
        },
        {
          "component": "richtext",
          "name": "values",
          "label": "Values",
          "description": "Variation 2. One paragraph (or list item) per comparison column, in column order. Use Shift+Enter for a line break inside a value.",
          "value": "",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "eligibility-tabs",
      "components": [
        "eligibility-tabs-item",
        "eligibility-tabs-row"
      ]
    }
  ]
}
