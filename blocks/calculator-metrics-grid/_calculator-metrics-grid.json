{
  "definitions": [
    {
      "title": "Calculator Metrics Grid",
      "id": "calculator-metrics-grid",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
                "name": "Calculator Metrics Grid",
                "model": "calculator-metrics-grid"
              }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "calculator-metrics-grid",
      "fields": [
        {
          "component": "select",
          "name": "calculator-type",
          "label": "Calculator type",
          "value": "fire",
          "options": [
            { "name": "FIRE calculator", "value": "fire" },
            { "name": "NPS calculator", "value": "nps" },
            { "name": "SWP calculator", "value": "swp" },
            { "name": "BMI calculator", "value": "bmi" },
            { "name": "Gratuity calculator", "value": "gratuity" }
          ]
        },
        {
          "component": "text",
          "name": "fire-number-label",
          "label": "FIRE number label",
          "value": "Your F.I.R.E number",
          "condition": { "===": [{ "var": "calculator-type" }, "fire"] }
        },
        {
          "component": "text",
          "name": "snapshot-title",
          "label": "Snapshot title",
          "value": "FIRE snapshot",
          "condition": { "===": [{ "var": "calculator-type" }, "fire"] }
