{
  "definitions": [
    {
      "title": "Result Summary With Canvas",
      "id": "result-summary-with-canvas",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Result Summary With Canvas",
              "model": "result-summary-with-canvas"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "result-summary-with-canvas",
      "fields": [
        {
          "component": "select",
          "name": "calculator-type",
          "label": "Calculator type",
          "value": "compound",
          "options": [
            { "name": "Compound calculator", "value": "compound" },
            { "name": "ULIP and investment calculator", "value": "ulip" },
            { "name": "Fixed deposit calculator", "value": "fd" },
            { "name": "Recurring deposit calculator", "value": "rd" },
            { "name": "SIP calculator", "value": "sip" },
            { "name": "PPF calculator", "value": "ppf" }
          ]
        },
        {
          "component": "text",
          "name": "result-label",
          "label": "Result label",
          "value": "You may get",
          "description": "Label shown above the calculated amount.",
          "condition": {
            "or": [
              { "===": [{ "var": "calculator-type" }, "compound"] },
              { "===": [{ "var": "calculator-type" }, "fd"] },
              { "===": [{ "var": "calculator-type" }, "rd"] },
              { "===": [{ "var": "calculator-type" }, "sip"] },
              { "===": [{ "var": "calculator-type" }, "ppf"] }
            ]
          }
        },
        {
          "component": "text",
          "name": "investment-summary-template",
          "label": "Investment summary template",
          "value": "If you invest {investmentAmount} {frequency} for {investmentYears} years at {rate}% p.a.",
          "description": "Supports {investmentAmount}, {frequency}, {investmentYears}, {holdingYears}, and {rate} placeholders.",
          "condition": {
            "or": [
              { "===": [{ "var": "calculator-type" }, "compound"] },
              { "===": [{ "var": "calculator-type" }, "fd"] },
              { "===": [{ "var": "calculator-type" }, "rd"] },
              { "===": [{ "var": "calculator-type" }, "ppf"] }
            ]
          }
        },
        {
          "component": "text",
          "name": "ulip-invested-label",
          "label": "Invested amount series label",
          "condition": {
            "or": [
              { "===": [{ "var": "calculator-type" }, "ulip"] },
              { "===": [{ "var": "calculator-type" }, "fd"] },
              { "===": [{ "var": "calculator-type" }, "compound"] },
              { "===": [{ "var": "calculator-type" }, "rd"] },
              { "===": [{ "var": "calculator-type" }, "sip"] }
            ]
          }
        },
        {
          "component": "text",
          "name": "chart-series-label",
          "label": "Chart series label",
          "value": "Your returns",
          "description": "Legend label shown above the dynamic returns chart.",
          "condition": {
            "or": [
              { "===": [{ "var": "calculator-type" }, "compound"] },
              { "===": [{ "var": "calculator-type" }, "fd"] },
              { "===": [{ "var": "calculator-type" }, "rd"] },
              { "===": [{ "var": "calculator-type" }, "sip"] },
              { "===": [{ "var": "calculator-type" }, "ppf"] }
            ]
          }
        },
        {
          "component": "text",
          "name": "cta-label",
          "label": "CTA label",
          "value": "Invest Now",
          "description": "Text displayed on the call-to-action button.",
          "condition": {
            "or": [
              { "===": [{ "var": "calculator-type" }, "compound"] },
              { "===": [{ "var": "calculator-type" }, "fd"] },
              { "===": [{ "var": "calculator-type" }, "rd"] },
              { "===": [{ "var": "calculator-type" }, "sip"] },
              { "===": [{ "var": "calculator-type" }, "ppf"] }
            ]
          }
        },
        {
          "component": "aem-content",
          "name": "cta-link",
          "label": "CTA destination",
          "description": "Page or fragment opened by the call-to-action button.",
          "condition": {
            "or": [
              { "===": [{ "var": "calculator-type" }, "compound"] },
              { "===": [{ "var": "calculator-type" }, "fd"] },
              { "===": [{ "var": "calculator-type" }, "rd"] },
              { "===": [{ "var": "calculator-type" }, "sip"] },
              { "===": [{ "var": "calculator-type" }, "ppf"] }
            ]
          }
        },
        {
          "component": "text",
          "name": "ulip-result-label",
          "label": "ULIP result label",
          "condition": { "===": [{ "var": "calculator-type" }, "ulip"] }
        },
        {
          "component": "text",
          "name": "ulip-investment-summary-template",
          "label": "ULIP investment summary template",
          "description": "Shown below the amount. Supports {investmentAmount}, {frequency}, {totalInvested}, {investmentYears}, {rate}, and {periodicInvestment}. Example: If you invest {investmentAmount} {frequency} for {investmentYears} years at {rate}% p.a.",
          "condition": { "===": [{ "var": "calculator-type" }, "ulip"] }
        },
        {
          "component": "text",
          "name": "ulip-returns-label",
          "label": "ULIP returns series label",
          "condition": { "===": [{ "var": "calculator-type" }, "ulip"] }
        },
        {
          "component": "text",
          "name": "ulip-cta-label",
          "label": "ULIP CTA label",
          "condition": { "===": [{ "var": "calculator-type" }, "ulip"] }
        },
        {
          "component": "aem-content",
          "name": "ulip-cta-link",
          "label": "ULIP CTA destination",
          "condition": { "===": [{ "var": "calculator-type" }, "ulip"] }
        }
      ]
    }
  ],
  "filters": []
}