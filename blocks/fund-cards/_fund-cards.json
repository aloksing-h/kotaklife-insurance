            { "name": "Low to Moderate", "value": "low-to-moderate" },
            { "name": "Moderate", "value": "moderate" },
            { "name": "Moderately High", "value": "moderately-high" },
            { "name": "High", "value": "high" },
            { "name": "Very High", "value": "very-high" }
