					"component": "select",
					"name": "calculator-type",
					"label": "Calculator type",
					"value": "retirement",
					"options": [
						{ "name": "Retirement calculator", "value": "retirement" },
						{ "name": "Savings calculator", "value": "savings" },
						{ "name": "HRA calculator", "value": "hra" },
						{ "name": "HLV calculator", "value": "hlv" }
					]
				},
				{
					"component": "text",
					"name": "fund-title",
