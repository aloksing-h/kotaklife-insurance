{
	"definitions": [
		{
			"title": "Result Summary Panel",
			"id": "result-summary-panel",
			"plugins": {
				"xwalk": {
					"page": {
						"resourceType": "core/franklin/components/block/v1/block",
						"template": {
							"name": "Result Summary Panel",
							"model": "result-summary-panel"
						}
					}
				}
			}
		}
	],
	"models": [
