					"label": "Fund title",
					"value": "Estimated retirement fund",
					"description": "Label shown above the calculated retirement fund."
				},
				{
					"component": "reference",
					"name": "illustration",
					"condition": { "===": [{ "var": "calculator-type" }, "retirement"] },
